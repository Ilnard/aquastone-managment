{
  "name": "aquastone-management",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "deploy": "node scripts/deploy.js",
    "seed": "node --env-file-if-exists=.env scripts/seed-processes.js",
    "reset-password": "node --env-file-if-exists=.env scripts/reset-password.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "^7.18.5",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
